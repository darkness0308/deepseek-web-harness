{
  "manifest_version": 3,
  "name": "DeepSeek Session Connector",
  "version": "1.0.0",
  "description": "One click: connects your signed-in chat.deepseek.com session to your own local harness (after you type /connect in it). Nothing leaves your computer.",
  "key": "",
  "permissions": [
    "cookies",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "http://127.0.0.1:47123/*"
  ],
  "action": {
    "default_title": "Connect to harness",
    "default_popup": "popup.html"
  }
}
