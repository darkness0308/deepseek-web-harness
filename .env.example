# ══════════════════════════════════════════════════════════════════════════════
#  DeepSeek Bridge — configuration template
# ══════════════════════════════════════════════════════════════════════════════
#
#  Copy this file to `.env` and fill in your own values:
#
#      copy .env.example .env          (Windows CMD)
#      cp .env.example .env            (PowerShell / bash)
#
#  `.env` is git-ignored and must NEVER be committed or shared — it holds your
#  DeepSeek account credentials.
#
# ══════════════════════════════════════════════════════════════════════════════

# ── DeepSeek account ──────────────────────────────────────────────────────────
# Your chat.deepseek.com login.  Used once to obtain session cookies; after
# that, `session.json` is what actually authenticates requests.
DS_EMAIL=
DS_PASSWORD=


# ── Local server ──────────────────────────────────────────────────────────────
# API port. The native terminal uses the runtime directly; --no-api skips binding.
BRIDGE_PORT=11434

# Interface to bind.
#   127.0.0.1 = this machine only                                   (default, safer)
#   0.0.0.0   = every network interface — reachable from your LAN
#
# The agent API can edit files and, when HARNESS_ALLOW_COMMANDS allows it, run
# commands, so keep 127.0.0.1 unless you need LAN access.  If you bind 0.0.0.0,
# set BRIDGE_API_KEY or create a named key first; the harness warns at startup
# when the API is exposed without one.
BRIDGE_HOST=127.0.0.1

# Waitress worker threads.
BRIDGE_THREADS=8


# ── API key protection (optional) ─────────────────────────────────────────────
# OPTION A — single shared key.  Every request to /v1/* must then send
#   Authorization: Bearer <this value>
BRIDGE_API_KEY=

# OPTION B — named keys (recommended). Create them from the legacy terminal
# (`python run.py --legacy-chat`):
#   /api my-laptop        create a key named "my-laptop"
#   /api-show             list all keys
#   /api-delete my-laptop delete one
# Stored in api_keys.json.  When any named key exists it is used INSTEAD of
# BRIDGE_API_KEY.
#
# Set true to refuse to serve until at least one API key exists.
REQUIRE_API_KEY=false


# ── Browser access (CORS) ─────────────────────────────────────────────────────
# Only needed if a web page calls this API directly.  Comma-separated origins.
# Only /v1/* is CORS-enabled, and credentials are not allowed.
#
# Leave this at the default when unsure.  A wildcard here would let any site
# you visit spend your DeepSeek quota.
BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173


# ── Request protections ───────────────────────────────────────────────────────
# While the API is bound to loopback, requests must address it as localhost / 127.0.0.1 / ::1
# (blocks DNS-rebinding web pages), and a request carrying a browser Origin must come from
# BRIDGE_ALLOWED_ORIGINS. SDKs, curl and scripts send no Origin and are unaffected.
# Extra Host names to accept (comma-separated), e.g. a local reverse proxy:
BRIDGE_ALLOWED_HOSTS=
# Largest request body in megabytes.
BRIDGE_MAX_BODY_MB=64
# Wrong API keys per client address per minute before a one-minute lockout (0 = off).
BRIDGE_AUTH_FAILURE_LIMIT=20
# A network-facing BRIDGE_HOST with no API key refuses requests. Set true only if you really want it open.
BRIDGE_ALLOW_OPEN_NETWORK=false


# ── Timeouts & retries (seconds) ──────────────────────────────────────────────
CONNECT_TIMEOUT=10

# How long a single streaming reply may run.  DeepSeek itself cuts a
# completion off at ~60s (see the terminal `/limits` command); raising this
# beyond that does not extend the upstream limit.
STREAM_TIMEOUT=120

UPLOAD_TIMEOUT=60

# Retries for transient network errors and 429/5xx responses.
MAX_RETRIES=3
RETRY_DELAY=1.5


# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Native coding harness ────────────────────────────────────────────────────
# deepseek-web uses the existing session.json login. openai uses a direct
# OpenAI-compatible Chat Completions provider, without an external harness.
HARNESS_PROVIDER=deepseek-web
HARNESS_MODEL=deepseek-chat
HARNESS_BASE_URL=https://api.deepseek.com/v1
HARNESS_API_KEY=

# Absolute directory for native file tools; defaults to this repository.
# HARNESS_WORKSPACE=C:/path/to/project
# Leave HARNESS_TOOLS unset to enable every built-in tool (recommended). Set it
# only to restrict the agent to a comma-separated subset of tool names.
# HARNESS_TOOLS=read_file,list_files,glob_files,search_files,write_file,edit_file

# Commands (run_command, run_shell, run_checks, start_process) run with your OS
# permissions; they are not sandboxed. File tools are confined to the workspace.
#   ask   - the terminal asks you to approve each command (default); API runs,
#           which have nobody to ask, are refused
#   true  - run without asking (API runs too). Use only in workspaces you trust
#   false - command tools are not offered at all
HARNESS_ALLOW_COMMANDS=ask
# Operator rules for commands (comma-separated globs matched case-insensitively against the
# command line, e.g. `git push*`). A deny rule blocks a command under EVERY policy, including
# true, and also catches it inside `a && b` / `a | b` chains. An allow rule approves a matching
# command without asking under `ask`, so unattended API runs can use it; commands containing
# $(...) or backticks are never auto-approved. Rules come only from here, never from the workspace.
# HARNESS_COMMAND_DENY=git push*,rm -rf*,*sudo*
# HARNESS_COMMAND_ALLOW=pytest*,python -m unittest*,git status,git diff*
# Same three values for web_fetch / web_search. Private/loopback addresses stay
# blocked unless HARNESS_WEB_ALLOW_PRIVATE=true.
HARNESS_ALLOW_WEB=ask
# HARNESS_WEB_ALLOW_PRIVATE=false
# web_search engine: auto (SearXNG if configured, then DuckDuckGo, then Bing) |
# duckduckgo | bing | searxng. DuckDuckGo often blocks scripted clients.
# HARNESS_SEARCH_ENGINE=auto
# HARNESS_SEARXNG_URL=http://localhost:8080/search

HARNESS_MAX_TURNS=40
HARNESS_PROTOCOL_RETRIES=2
# Retry only a confirmed rate-limit refusal, never an uncertain request/effect.
HARNESS_RATE_LIMIT_RETRIES=4
HARNESS_RATE_LIMIT_DELAY=15
# A DeepSeek web request that fails before any reply arrives (connection error, timeout,
# HTTP 5xx) is repeated this many times; a reply that already started is never repeated.
HARNESS_PROVIDER_RETRIES=2
HARNESS_PROVIDER_RETRY_DELAY=1.5
# Whole-run deadline. Time spent waiting for your approval does not count.
HARNESS_TIMEOUT=600
# Default per-command deadline; a command can ask for more up to the maximum.
# A timed-out command returns partial output; it does not end the run.
HARNESS_TOOL_TIMEOUT=120
HARNESS_MAX_TOOL_TIMEOUT=900
HARNESS_MAX_TOOL_OUTPUT=32000
# Kill excessive command output; stdout/stderr returned to the model are clipped.
HARNESS_MAX_COMMAND_OUTPUT_BYTES=8000000
HARNESS_MAX_SESSIONS=256
# Background processes per session (start_process) and sub-agent limits.
HARNESS_MAX_PROCESSES=8
HARNESS_SUBAGENT_TIMEOUT=240
HARNESS_SUBAGENT_MAX_TURNS=20
# Simultaneous completions sent to the DeepSeek web account (it rate-limits bursts).
HARNESS_PROVIDER_CONCURRENCY=2
# One self-check before a tool-using run may finish: auto (DeepSeek web only) | true | false
HARNESS_COMPLETION_CHECK=auto

# Private durable sessions. One process per database; CLI and API share it.
HARNESS_PERSISTENCE=true
# HARNESS_STATE_PATH=C:/path/to/project/.harness/state.sqlite3
HARNESS_CONTEXT_CHARS=120000
HARNESS_MAX_FILE_BYTES=2000000
# Optional local JSON stdio-server configuration (see advanced-harness.md).
# HARNESS_MCP_CONFIG=C:/path/to/project/.harness/mcp.json
# Override skill roots with semicolon-separated paths on Windows.
# HARNESS_SKILL_PATHS=C:/path/to/project/.harness/skills;C:/path/to/bundled/skills

# DeepSeek web login without the captcha: drop a browser export into cookies/ (see cookies/README.txt).
# It is imported on startup, on /refresh and when DeepSeek rejects the saved token.
# HARNESS_COOKIE_DIR=cookies
# Set to 0 to stop the automatic import (python import_session.py still works).
HARNESS_COOKIE_AUTO_IMPORT=1
# Path of Chrome/Edge for refresh_session.py when it is not in a standard location.
# DS_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# /connect (browser extension pairing) listens on 127.0.0.1 only, for this many seconds. The extension expects port 47123.
# HARNESS_CONNECT_PORT=47123
# HARNESS_CONNECT_SECONDS=120
# Extra extension IDs (comma separated) allowed to connect; the bundled extension is always allowed.
# HARNESS_CONNECT_EXTENSION_IDS=

# Context management. The model sees at most HARNESS_CONTEXT_CHARS characters (instructions + tools + conversation).
# When it passes HARNESS_AUTOCOMPACT percent, old tool results are cleared and earlier steps are summarized. 0 = off.
HARNESS_AUTOCOMPACT=80
# Proactive summaries per run (summaries that are required because steps were being dropped are never capped).
HARNESS_AUTOCOMPACT_MAX=6
# Recent steps whose tool results are never cleared; tool results at least this long are clearable when old.
HARNESS_COMPACT_KEEP=6
HARNESS_MICROCOMPACT_MIN=1200
# Upper bound for one summary (characters).
HARNESS_SUMMARY_CHARS=9000
